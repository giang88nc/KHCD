# KHCD only. Public TLS :8200, private Waitress 127.0.0.1:8201.
# Same trusted LAN root CA as KHBL; certificates and keys stay in ignored instance/.
{
	admin off
	auto_https disable_redirects
	skip_install_trust
	storage file_system "D:/PYTHON/KHCD/instance/caddy-data"
	servers :8200 {
		protocols h1 h2
		listener_wrappers {
			http_redirect
			tls
		}
	}
}

https://tiemvangkimhanh2:8200, https://localhost:8200, https://127.0.0.1:8200, https://192.168.1.6:8200, https://192.168.1.9:8200, https://mrgiang:8200 {
	tls internal
	encode zstd gzip
	log {
		output file "D:/PYTHON/KHCD/instance/caddy-access.log" {
			roll_size 10MiB
			roll_keep 3
		}
		format json
	}
	header -Server
	reverse_proxy 127.0.0.1:8201 {
		header_up X-Forwarded-Proto https
	}
}
